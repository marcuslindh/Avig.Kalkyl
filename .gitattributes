# Radsluten ska inte lamnas till den enskilda maskinens core.autocrlf - ett paket som
# byggs likadant overallt ska ocksa se likadant ut i diffen overallt.
* text=auto eol=crlf

*.sh text eol=lf

*.png binary
*.jpg binary
*.snk binary
*.nupkg binary

# Fuzz inputs are bytes, not text: a line-ending conversion would change the seeds
tools/Avig.Kalkyl.Fuzz/corpus/** binary
