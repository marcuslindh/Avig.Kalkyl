<Project>

  <!-- Shared metadata for the library and the tests. -->
  <PropertyGroup>
    <Authors>Marcus Lindh</Authors>
    <Company>Marcus Lindh</Company>
    <Copyright>Copyright (c) 2026 Marcus Lindh</Copyright>
    <NeutralLanguage>sv</NeutralLanguage>
    <RepositoryUrl>https://github.com/marcuslindh/Avig.Kalkyl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/marcuslindh/Avig.Kalkyl</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time rules, not a dependency of the package. publish.ps1 fails if anything but
         Avig.Result makes it into the nuspec. -->
    <PackageReference Include="Avig.Analyzers" Version="1.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
