<Project Sdk="Microsoft.NET.Sdk">

  <!-- The gallery: example workbooks built with the public API only, and a renderer that
       opens them in Excel through COM and saves a picture of each for the README. Not packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avig.Kalkyl\Avig.Kalkyl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Avig" />
    <Using Include="Avig.Kalkyl" />
  </ItemGroup>

</Project>
