<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Turns on the trimming and AOT analyzers. The package must work in a Native AOT
         app, which is one of the differences from the libraries it is modelled on. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 0.x until all five milestones are done. The first public version will be 1.0.0. -->
    <IsPackable>true</IsPackable>
    <PackageId>Avig.Kalkyl</PackageId>
    <Version>0.1.0</Version>
    <Title>Avig.Kalkyl</Title>
    <Description>Read, write, edit and calculate Excel .xlsx files: typed lists through a source generator, streaming rows, and a document model with a formula engine. Styles, charts, pictures and SVG, shapes, conditional formatting, pivot tables and slicers, and a check for macros and links in files from outside. Failures come back as Avig.Result values. No dependencies besides Avig.Result and Avig.OpenXml; trimming and Native AOT safe.</Description>
    <PackageTags>excel;xlsx;spreadsheet;openxml;streaming;charts;conditional-formatting;pivot-tables;dashboard</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avig.Result" Version="1.0.2" />
    <PackageReference Include="Avig.OpenXml" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DrawingML types (Shape, Fill, Picture, ChartAxis ...) live in Avig.OpenXml. -->
    <Using Include="Avig.OpenXml.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Avig.Kalkyl.Tests" />
    <!-- The fuzz harness tests the internal conversions (CellText, ExcelDate, FormulaShifter) directly. -->
    <InternalsVisibleTo Include="Avig.Kalkyl.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source generator is built before the package but not referenced by it: it ships under
         analyzers/dotnet/cs, where the compiler of whoever uses the package finds it. -->
    <ProjectReference Include="..\Avig.Kalkyl.Generators\Avig.Kalkyl.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Avig.Kalkyl.Generators\bin\$(Configuration)\netstandard2.0\Avig.Kalkyl.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
