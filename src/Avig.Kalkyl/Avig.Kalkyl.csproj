<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Turns on the trimming and AOT analyzers. The package must work in a Native AOT
         app, which is one of the differences from the libraries it is modelled on. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 0.x until all five milestones are done. The first public version will be 1.0.0. -->
    <IsPackable>true</IsPackable>
    <PackageId>Avig.Kalkyl</PackageId>
    <Version>0.1.0</Version>
    <Title>Avig.Kalkyl</Title>
    <Description>Read and write Excel .xlsx files: streaming rows, cell values as a typed union with a Try pattern, fluent styles that are deduplicated for you, and automatic date detection. Failures come back as Avig.Result values. No dependencies besides Avig.Result; trimming and Native AOT safe.</Description>
    <PackageTags>excel;xlsx;spreadsheet;openxml;streaming</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avig.Result" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Avig.Kalkyl.Tests" />
    <!-- The fuzz harness tests the internal conversions (CellText, ExcelDate, FormulaShifter) directly. -->
    <InternalsVisibleTo Include="Avig.Kalkyl.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source generator is built before the package but not referenced by it: it ships under
         analyzers/dotnet/cs, where the compiler of whoever uses the package finds it. -->
    <ProjectReference Include="..\Avig.Kalkyl.Generators\Avig.Kalkyl.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Avig.Kalkyl.Generators\bin\$(Configuration)\netstandard2.0\Avig.Kalkyl.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
