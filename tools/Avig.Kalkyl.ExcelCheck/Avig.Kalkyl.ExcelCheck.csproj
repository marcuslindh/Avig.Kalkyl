<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avig.Kalkyl\Avig.Kalkyl.csproj" />
    <!-- The README gallery; files 19 and on are its workbooks. -->
    <ProjectReference Include="..\..\samples\Avig.Kalkyl.Samples\Avig.Kalkyl.Samples.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The workbook with active content that the tests build; file 13 is it, cleaned. -->
    <Compile Include="..\..\tests\Avig.Kalkyl.Tests\ActiveWorkbook.cs" Link="ActiveWorkbook.cs" />
    <!-- The dashboard the tests build; files 14 and 15 are it. -->
    <Compile Include="..\..\tests\Avig.Kalkyl.Tests\DashboardWorkbook.cs" Link="DashboardWorkbook.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Avig" />
    <Using Include="Avig.Kalkyl" />
    <Using Include="Avig.OpenXml.Drawing" />
  </ItemGroup>

</Project>
