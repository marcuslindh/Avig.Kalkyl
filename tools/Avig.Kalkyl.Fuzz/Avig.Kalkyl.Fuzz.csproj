<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Avig.Kalkyl.Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- SharpFuzz instruments the IL of Avig.Kalkyl.dll after publish, so the assemblies must
         stay plain IL: no ReadyToRun and no AOT. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <!-- CA5394: System.Random is the point here. A fuzz input must be reproducible from its seed,
         not unpredictable. -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avig.Kalkyl\Avig.Kalkyl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Avig" />
    <Using Include="Avig.Kalkyl" />
    <Using Include="Avig.OpenXml.Drawing" />
  </ItemGroup>

</Project>
